output "eDP-1" {
    scale 1.8
}

output "Dell Inc. DELL U3818DW *" {
    scale 2
}

profile laptop {
    output eDP-1 enable
}

profile desk {
    output "Dell Inc. DELL U3818DW *" enable
}

profile dual {
    output eDP-1 enable position 0,0
    output "Dell Inc. DELL U3818DW *" enable position 1920,0
}
